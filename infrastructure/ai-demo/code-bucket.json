{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private isolated code artifacts for the EASI View AI demonstration. No medical data, credentials, DNS or marketing resource changes.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  },
  "Resources": {
    "CodeBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Store immutable SHA256-derived gateway ZIP deployment artifacts.",
          "must": "Private, encrypted, versioned; never store invitation codes or medical images."
        }
      },
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      }
    },
    "CodeBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Require HTTPS for deployment artifacts.",
          "must": "Do not grant public or anonymous read access."
        }
      },
      "Properties": {
        "Bucket": {
          "Ref": "CodeBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireTls",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "CodeBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${CodeBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "CodeBucket": {
      "Description": "Private encrypted code-artifact bucket for this isolated demo.",
      "Value": {
        "Ref": "CodeBucket"
      }
    }
  }
}
